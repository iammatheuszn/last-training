# Last Training — variáveis de ambiente
# Copie para .env na raiz. O servidor e o preflight leem este arquivo quando presente.
# Nenhum valor secreto deve ser commitado.

# development | production
LT_ENV=development

# API
LT_SERVER_HOST=127.0.0.1
LT_SERVER_PORT=8787
LT_BASE_URL=https://127.0.0.1:8787
LT_AUTH_API_BASE_URL=https://127.0.0.1:8787
LT_PUBLIC_ORIGIN=https://127.0.0.1:8787
LT_DB_PATH=server/data/last-training.db

# Segredo JWT — obrigatório em produção, mínimo 32 caracteres
AUTH_JWT_SECRET=

# TLS local. Use LT_TLS_TERMINATED=true quando o proxy encerra HTTPS.
LT_TLS_KEY=
LT_TLS_CERT=
LT_TLS_TERMINATED=false

# Confiança em X-Forwarded-For atrás de proxy reverso
LT_TRUST_PROXY=false
LT_TRUSTED_PROXIES=127.0.0.1,::1

# Tokens e limites
LT_ACCESS_TTL=900
LT_REFRESH_TTL_DAYS=30
LT_MAX_DEVICES=3
LT_LOGIN_MAX_FAILURES=5
LT_LOGIN_WINDOW_MS=600000
LT_LOGIN_LOCK_MS=900000
LT_GLOBAL_MAX_PER_MINUTE=180
LT_REQUEST_ID_TTL_MS=300000
LT_ADMIN_TTL=900
LT_ADMIN_LOGIN_MAX_FAILURES=5
LT_ADMIN_LOGIN_WINDOW_MS=900000
LT_ADMIN_LOGIN_LOCK_MS=900000

# Bootstrap local do banco
LT_SEED_EMAIL=
LT_SEED_PASSWORD=
LT_ADMIN_EMAIL=
LT_ADMIN_PASSWORD=
LT_ADMIN_DISPLAY=Administrador

# Cliente Electron
LT_LOCAL_DB_PATH=
NODE_EXTRA_CA_CERTS=

# Atualizações assinadas
LT_UPDATE_URL=
LT_UPDATE_PUBLIC_KEY=
LT_UPDATE_PRIVATE_KEY=
LT_UPDATE_PRIVATE_KEY_PATH=

# Backup e auditoria
LT_BACKUP_DIR=server/backups
LT_BACKUP_RETENTION=7
LT_LOG_DIR=server/logs
